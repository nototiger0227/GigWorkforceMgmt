generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COMPANY
  RIDER
}

enum GigStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AssignmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role
  companyId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])
  rider   Rider?

  statusChanges GigStatusHistory[] @relation("StatusChangedBy")
  notifications   Notification[]
}

model Company {
  id           String   @id @default(cuid())
  name         String
  contactEmail String?
  contactPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User?
  zones Zone[]
  gigs  Gig[]
}

model Zone {
  id        String   @id @default(cuid())
  name      String
  city      String
  companyId String
  centerLat Float?
  centerLng Float?
  radiusKm  Float    @default(5)
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  gigs    Gig[]

  @@index([companyId])
}

model Rider {
  id             String    @id @default(cuid())
  userId         String    @unique
  isOnline       Boolean   @default(false)
  isVerified     Boolean   @default(false)
  platformTags   String[]
  currentGigId   String?
  lastLat        Float?
  lastLng        Float?
  lastLocationAt DateTime?
  walletBalance  Decimal   @default(0) @db.Decimal(10, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  payouts     Payout[]
  withdrawals Withdrawal[]
  kycSubmissions KycSubmission[]

  @@index([isOnline])
}

model Gig {
  id              String    @id @default(cuid())
  companyId       String
  zoneId          String?
  title           String
  description     String?
  pickupZone      String
  serviceArea     String
  pickupLat       Float?
  pickupLng       Float?
  requiredRiders  Int       @default(1)
  basePayAmount   Decimal   @db.Decimal(10, 2)
  surgeMultiplier Decimal   @default(1) @db.Decimal(4, 2)
  payAmount       Decimal   @db.Decimal(10, 2)
  currency        String    @default("INR")
  urgency         Urgency
  status          GigStatus @default(OPEN)
  partnerSource       String?
  externalId          String?
  preferPlatformTags  String[]
  startsAt            DateTime
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  zone        Zone?              @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  assignments Assignment[]
  history     GigStatusHistory[]

  @@unique([partnerSource, externalId])
  @@index([status, zoneId, startsAt])
  @@index([companyId])
  @@index([status])
}

model Assignment {
  id          String           @id @default(cuid())
  gigId       String
  riderId     String
  status      AssignmentStatus @default(PENDING)
  acceptedAt  DateTime         @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  gig    Gig     @relation(fields: [gigId], references: [id], onDelete: Cascade)
  rider  Rider   @relation(fields: [riderId], references: [id], onDelete: Cascade)
  payout Payout?

  @@unique([gigId, riderId])
  @@index([riderId])
  @@index([gigId])
}

model Payout {
  id           String       @id @default(cuid())
  riderId      String
  assignmentId String       @unique
  amount       Decimal      @db.Decimal(10, 2)
  status       PayoutStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  paidAt       DateTime?

  rider      Rider      @relation(fields: [riderId], references: [id], onDelete: Cascade)
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([riderId])
  @@index([status])
}

model Withdrawal {
  id         String       @id @default(cuid())
  riderId    String
  amount     Decimal      @db.Decimal(10, 2)
  upiId      String
  status     PayoutStatus @default(PENDING)
  providerId String?
  createdAt  DateTime     @default(now())
  processedAt DateTime?

  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId])
  @@index([status])
}

model KycSubmission {
  id             String    @id @default(cuid())
  riderId        String
  documentType   String
  documentNumber String
  status         KycStatus @default(PENDING)
  reviewNote     String?
  reviewedById   String?
  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?

  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId])
  @@index([status])
}

model WebhookDelivery {
  id          String                @id @default(cuid())
  partner     String
  event       String
  payload     Json
  status      WebhookDeliveryStatus @default(PENDING)
  attempts    Int                   @default(0)
  maxAttempts Int                   @default(3)
  lastError   String?
  nextRetryAt DateTime?
  createdAt   DateTime              @default(now())
  deliveredAt DateTime?

  @@index([status, nextRetryAt])
  @@index([partner])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

model GigStatusHistory {
  id          String     @id @default(cuid())
  gigId       String
  fromStatus  GigStatus?
  toStatus    GigStatus
  changedById String?
  reason      String?
  createdAt   DateTime   @default(now())

  gig       Gig   @relation(fields: [gigId], references: [id], onDelete: Cascade)
  changedBy User? @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([gigId])
  @@index([createdAt])
}
